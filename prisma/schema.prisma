generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
}

enum AdminAuthChallengePurpose {
  TOTP_ENROLLMENT
  TOTP_VERIFICATION
}

enum EmailDeliveryState {
  PENDING
  PROCESSING
  RETRYING
  SENT
  NEEDS_ATTENTION
}

enum EmailAttemptOutcome {
  PROCESSING
  SENT
  TEMPORARY
  PERMANENT
  RATE_LIMITED
  AUTHENTICATION
  INVALID_REQUEST
  UNKNOWN_OUTCOME
}

enum VoucherStatus {
  AVAILABLE
  SOLD
}

enum VoucherBatchImportState {
  IMPORTING
  IMPORTED
  FAILED
  DISCARDED
}

enum PurchaseChannel {
  WEB
  USSD
}

enum OrderDeliveryPreference {
  SMS_ONLY
  EMAIL_ONLY
  SMS_AND_EMAIL
}

enum PaymentAttemptStatus {
  INITIALIZING
  PENDING
  UNKNOWN
  SUCCEEDED
  FAILED
}

enum PaymentProviderEventOutcome {
  APPLIED
  REJECTED
  ADDITIONAL_SUCCESS
}

model AdminInvitation {
  id                   BigInt                        @id @default(autoincrement())
  publicId             String                        @unique @default(uuid()) @db.Uuid
  email                String
  activeEmail          String?                       @unique
  role                 AdminRole
  tokenFingerprint     String                        @unique
  encryptedToken       Json?
  expiresAt            DateTime                      @db.Timestamptz(6)
  acceptedAt           DateTime?                     @db.Timestamptz(6)
  revokedAt            DateTime?                     @db.Timestamptz(6)
  invitedByAdminUserId BigInt
  createdAt            DateTime                      @default(now()) @db.Timestamptz(6)
  invitedBy            AdminUser                     @relation("AdminInvitationSender", fields: [invitedByAdminUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emailDelivery        AdminInvitationEmailDelivery?

  @@index([email, expiresAt])
}

model AdminInvitationEmailDelivery {
  id                  BigInt                        @id @default(autoincrement())
  publicId            String                        @unique @default(uuid()) @db.Uuid
  invitationId        BigInt                        @unique
  destinationEmail    String
  state               EmailDeliveryState            @default(PENDING)
  attemptCount        Int                           @default(0)
  nextAttemptAt       DateTime                      @default(now()) @db.Timestamptz(6)
  processingStartedAt DateTime?                     @db.Timestamptz(6)
  providerMessageId   String?
  lastFailureCategory String?
  needsAttentionAt    DateTime?                     @db.Timestamptz(6)
  createdAt           DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                      @updatedAt @db.Timestamptz(6)
  invitation          AdminInvitation               @relation(fields: [invitationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempts            AdminInvitationEmailAttempt[]

  @@index([state, nextAttemptAt, id])
}

model AdminInvitationEmailAttempt {
  id                BigInt                       @id @default(autoincrement())
  deliveryId        BigInt
  attemptNumber     Int
  provider          String
  outcome           EmailAttemptOutcome          @default(PROCESSING)
  providerMessageId String?
  providerCode      String?
  startedAt         DateTime                     @default(now()) @db.Timestamptz(6)
  completedAt       DateTime?                    @db.Timestamptz(6)
  delivery          AdminInvitationEmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, startedAt])
}

model AdminUser {
  id                        BigInt               @id @default(autoincrement())
  publicId                  String               @unique @default(uuid()) @db.Uuid
  email                     String               @unique
  passwordHash              String
  role                      AdminRole
  isInitialSuperAdmin       Boolean              @default(false)
  isActive                  Boolean              @default(true)
  failedAuthenticationCount Int                  @default(0)
  lockedUntil               DateTime?            @db.Timestamptz(6)
  pendingTotpSecret         Json?
  totpSecret                Json?
  totpEnabledAt             DateTime?            @db.Timestamptz(6)
  passwordChangedAt         DateTime             @default(now()) @db.Timestamptz(6)
  lastAuthenticatedAt       DateTime?            @db.Timestamptz(6)
  createdAt                 DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime             @updatedAt @db.Timestamptz(6)
  sessions                  AdminSession[]
  challenges                AdminAuthChallenge[]
  securityEvents            AdminSecurityEvent[]
  invitationsSent           AdminInvitation[]    @relation("AdminInvitationSender")
}

model AdminAuthChallenge {
  id                 BigInt                    @id @default(autoincrement())
  adminUserId        BigInt
  tokenFingerprint   String                    @unique
  purpose            AdminAuthChallengePurpose
  expiresAt          DateTime                  @db.Timestamptz(6)
  consumedAt         DateTime?                 @db.Timestamptz(6)
  failedAttemptCount Int                       @default(0)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(6)
  adminUser          AdminUser                 @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([adminUserId, purpose, expiresAt])
}

model AdminSession {
  id               BigInt    @id @default(autoincrement())
  publicId         String    @unique @default(uuid()) @db.Uuid
  adminUserId      BigInt
  tokenFingerprint String    @unique
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  lastSeenAt       DateTime  @default(now()) @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([adminUserId, expiresAt])
}

model AdminSecurityEvent {
  id            BigInt     @id @default(autoincrement())
  adminUserId   BigInt?
  eventType     String
  correlationId String
  metadata      Json
  occurredAt    DateTime   @default(now()) @db.Timestamptz(6)
  adminUser     AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([adminUserId, occurredAt])
  @@index([eventType, occurredAt])
}

model CatalogGroup {
  id        BigInt         @id @default(autoincrement())
  publicId  String         @unique @default(uuid()) @db.Uuid
  code      String         @unique
  name      String
  parentId  BigInt?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)
  parent    CatalogGroup?  @relation("CatalogGroupHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children  CatalogGroup[] @relation("CatalogGroupHierarchy")
  products  Product[]

  @@index([parentId, sortOrder, id])
}

model Product {
  id                 BigInt              @id @default(autoincrement())
  publicId           String              @unique @default(uuid()) @db.Uuid
  catalogGroupId     BigInt
  code               String              @unique
  name               String
  description        String?
  sellingPriceMinor  BigInt
  currency           String              @db.Char(3)
  resultCheckerUrl   String?
  lowStockThreshold  Int                 @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  catalogGroup       CatalogGroup        @relation(fields: [catalogGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voucherBatches     VoucherBatch[]
  vouchers           Voucher[]
  orderItems         OrderItem[]
  fulfilmentUnits    FulfilmentUnit[]
  voucherAllocations VoucherAllocation[]

  @@index([catalogGroupId, code, id])
}

model Order {
  id                  BigInt                  @id @default(autoincrement())
  publicReference     String                  @unique @default(uuid()) @db.Uuid
  purchaseChannel     PurchaseChannel
  deliveryPreference  OrderDeliveryPreference
  firstName           String?
  phoneNumber         String?
  email               String?
  contactAnonymizedAt DateTime?               @db.Timestamptz(6)
  totalPriceMinor     BigInt
  currency            String                  @db.Char(3)
  createdAt           DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(6)
  items               OrderItem[]
  paymentAttempts     PaymentAttempt[]
  paymentApplication  PaymentApplication?

  @@index([createdAt, id])
  @@index([purchaseChannel, createdAt, id])
}

model OrderItem {
  id              BigInt           @id @default(autoincrement())
  orderId         BigInt           @unique
  productId       BigInt
  quantity        Int
  unitPriceMinor  BigInt
  totalPriceMinor BigInt
  currency        String           @db.Char(3)
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fulfilmentUnits FulfilmentUnit[]

  @@unique([id, productId])
  @@index([productId, id])
}

model PaymentAttempt {
  id                     BigInt                 @id @default(autoincrement())
  publicReference        String                 @unique @default(uuid()) @db.Uuid
  orderId                BigInt
  provider               String
  providerReference      String
  status                 PaymentAttemptStatus   @default(INITIALIZING)
  expectedAmountMinor    BigInt
  currency               String                 @db.Char(3)
  authorizationUrl       String?
  accessCode             String?
  providerTransactionId  String?
  providerStatus         String?
  paidAt                 DateTime?              @db.Timestamptz(6)
  verifiedAt             DateTime?              @db.Timestamptz(6)
  nextVerificationAt     DateTime?              @db.Timestamptz(6)
  verificationLeaseUntil DateTime?              @db.Timestamptz(6)
  verificationAttempts   Int                    @default(0)
  needsAttentionAt       DateTime?              @db.Timestamptz(6)
  attentionReason        String?
  createdAt              DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(6)
  order                  Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  application            PaymentApplication?
  providerEvents         PaymentProviderEvent[]

  @@unique([provider, providerReference])
  @@unique([provider, providerTransactionId])
  @@index([orderId, createdAt, id])
  @@index([status, nextVerificationAt, id])
}

model PaymentProviderEvent {
  id                    BigInt                      @id @default(autoincrement())
  paymentAttemptId      BigInt?
  provider              String
  eventType             String
  providerReference     String
  providerTransactionId String?
  payloadFingerprint    String
  outcome               PaymentProviderEventOutcome
  rejectionReason       String?
  receivedAt            DateTime                    @default(now()) @db.Timestamptz(6)
  processedAt           DateTime                    @default(now()) @db.Timestamptz(6)
  paymentAttempt        PaymentAttempt?             @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, eventType, providerReference])
  @@unique([provider, payloadFingerprint])
  @@index([paymentAttemptId, receivedAt, id])
  @@index([outcome, receivedAt, id])
}

model PaymentApplication {
  id               BigInt           @id @default(autoincrement())
  orderId          BigInt           @unique
  paymentAttemptId BigInt           @unique
  appliedAt        DateTime         @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentAttempt   PaymentAttempt   @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fulfilmentUnits  FulfilmentUnit[]
}

model FulfilmentUnit {
  id                   BigInt             @id @default(autoincrement())
  publicReference      String             @unique @default(uuid()) @db.Uuid
  paymentApplicationId BigInt
  orderItemId          BigInt
  orderPublicReference String             @db.Uuid
  productId            BigInt
  productPublicId      String             @db.Uuid
  ordinal              Int
  paidAt               DateTime           @db.Timestamptz(6)
  allocatedAt          DateTime?          @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  paymentApplication   PaymentApplication @relation(fields: [paymentApplicationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItem            OrderItem          @relation(fields: [orderItemId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Cascade)
  product              Product            @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  allocation           VoucherAllocation?

  @@unique([orderItemId, ordinal])
  @@unique([id, productId])
  @@index([paymentApplicationId, id])
  @@index([orderPublicReference, id])
  @@index([paidAt, id])
}

model VoucherBatch {
  id            BigInt                  @id @default(autoincrement())
  publicId      String                  @unique @default(uuid()) @db.Uuid
  productId     BigInt
  reference     String
  validUntil    DateTime?               @db.Timestamptz(6)
  importState   VoucherBatchImportState @default(IMPORTING)
  totalQuantity Int                     @default(0)
  activatedAt   DateTime?               @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @db.Timestamptz(6)
  product       Product                 @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vouchers      Voucher[]

  @@unique([id, productId])
  @@index([productId, activatedAt, id])
  @@index([importState, updatedAt, id])
}

model Voucher {
  id             BigInt             @id @default(autoincrement())
  publicId       String             @unique @default(uuid()) @db.Uuid
  productId      BigInt
  batchId        BigInt
  serialNumber   String
  encryptedPin   Json
  pinFingerprint String
  status         VoucherStatus      @default(AVAILABLE)
  soldAt         DateTime?          @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(6)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  batch          VoucherBatch       @relation(fields: [batchId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Cascade, map: "Voucher_batch_product_match_fkey")
  allocation     VoucherAllocation?

  @@unique([productId, serialNumber])
  @@unique([productId, pinFingerprint])
  @@unique([id, productId])
  @@index([batchId, id])
}

model VoucherAllocation {
  id               BigInt         @id @default(autoincrement())
  publicReference  String         @unique @default(uuid()) @db.Uuid
  fulfilmentUnitId BigInt         @unique
  voucherId        BigInt         @unique
  productId        BigInt
  allocatedAt      DateTime       @default(now()) @db.Timestamptz(6)
  fulfilmentUnit   FulfilmentUnit @relation(fields: [fulfilmentUnitId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Cascade)
  voucher          Voucher        @relation(fields: [voucherId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([fulfilmentUnitId, productId])
  @@unique([voucherId, productId])
  @@index([allocatedAt, id])
  @@index([productId, allocatedAt, id])
}

// Platform-owned durable records. Domain modules own their business tables and
// insert outbox rows in the same transaction as their state transitions.
model OutboxEvent {
  id               BigInt    @id @default(autoincrement())
  aggregateType    String
  aggregateId      BigInt
  eventType        String
  payload          Json
  dedupeKey        String?   @unique
  occurredAt       DateTime  @default(now()) @db.Timestamptz(6)
  availableAt      DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt      DateTime? @db.Timestamptz(6)
  lockedAt         DateTime? @db.Timestamptz(6)
  lockOwner        String?
  needsAttentionAt DateTime? @db.Timestamptz(6)
  attempts         Int       @default(0)
  lastFailureCode  String?
}

model IdempotencyRecord {
  id                 BigInt            @id @default(autoincrement())
  scope              String
  key                String
  requestFingerprint String
  status             IdempotencyStatus @default(PROCESSING)
  responseStatus     Int?
  responseReference  String?
  expiresAt          DateTime          @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  completedAt        DateTime?         @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([scope, expiresAt, id])
}
