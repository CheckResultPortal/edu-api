{
  "name": "edu-api",
  "version": "1.0.0",
  "description": "Backend API for the Check Result Portal education platform.",
  "private": true,
  "scripts": {
    "build": "pnpm exec nx run-many -t build --exclude=edu-api",
    "lint": "pnpm exec nx run-many -t lint --exclude=edu-api",
    "typecheck": "pnpm exec nx run-many -t typecheck --exclude=edu-api",
    "test": "pnpm exec nx run-many -t test --exclude=edu-api",
    "test:coverage": "pnpm exec nx run-many -t test --coverage --exclude=edu-api",
    "admin:create-super-admin": "pnpm exec tsx --tsconfig tsconfig.base.json prisma/create-super-admin.ts",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "graph": "pnpm exec nx graph"
  },
  "keywords": [
    "education",
    "results",
    "nestjs",
    "nx"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/jest": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "23.1.1",
    "prettier": "~3.6.2",
    "prisma": "^7.9.1",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "nx": {},
  "dependencies": {
    "@fastify/static": "10.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "axios": "^1.6.0",
    "bullmq": "^6.0.5",
    "fastify": "^5.11.0",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.4.3"
  }
}
