NODE_ENV=development
SERVICE_NAME=public-api
HOST=0.0.0.0
PORT=3001
TRUST_PROXY_HOPS=0
CORS_ALLOWED_ORIGINS="http://localhost:3000"
LOG_LEVEL=log
DATABASE_URL="postgresql://edu_api:edu_api@localhost:5433/edu_api?schema=public"
REDIS_URL="redis://localhost:6380"
ORDER_PRIVACY_HMAC_KEY="replace-with-a-32-byte-base64url-key"
ORDER_IDEMPOTENCY_TTL_MS=86400000
ORDER_RATE_LIMIT_WINDOW_MS=600000
ORDER_RATE_LIMIT_IP_MAXIMUM=30
ORDER_RATE_LIMIT_PHONE_MAXIMUM=10
# Customer order status and voucher-copy requests use separate counters.
ORDER_STATUS_RATE_LIMIT_WINDOW_MS=600000
ORDER_STATUS_RATE_LIMIT_IP_MAXIMUM=30
ORDER_STATUS_RATE_LIMIT_CONTACT_MAXIMUM=10
# Server-only Paystack configuration. Never expose PAYSTACK_SECRET_KEY in the browser.
PAYSTACK_SECRET_KEY="replace-with-paystack-secret-key"
PAYSTACK_BASE_URL="https://api.paystack.co/"
PAYSTACK_REQUEST_TIMEOUT_MS=10000
PAYSTACK_CALLBACK_URL="http://localhost:3000/payment/callback"
PAYMENT_IDEMPOTENCY_TTL_MS=86400000
PAYMENT_INITIAL_VERIFICATION_DELAY_MS=120000
PAYMENT_RATE_LIMIT_WINDOW_MS=600000
PAYMENT_RATE_LIMIT_IP_MAXIMUM=30
PAYMENT_RATE_LIMIT_ORDER_MAXIMUM=10
# Nalo USSD is disabled until Nalo supplies its production gateway source IPs.
# When enabling it, inject all collection/Nalo values through secret management.
USSD_ENABLED=false
# NALO_USER_ID="replace-with-nalo-userid"
# NALO_TRUSTED_SOURCE_IPS="203.0.113.10,203.0.113.11"
# MOOLRE_API_USER="replace-with-moolre-api-user"
# MOOLRE_PUBLIC_KEY="replace-with-moolre-public-key"
# MOOLRE_ACCOUNT_NUMBER="replace-with-moolre-account-number"
# MOOLRE_BASE_URL="https://api.moolre.com/"
# MOOLRE_REQUEST_TIMEOUT_MS=10000
USSD_MAX_PRODUCTS=4
USSD_SESSION_TTL_MS=300000
USSD_PENDING_PAYMENT_TTL_MS=900000
# Set a real support number to show the USSD support option.
CUSTOMER_SUPPORT_PHONE=

# Required for Moolre callbacks when USSD_ENABLED=true.
MOOLRE_WEBHOOK_SECRET=
