NODE_ENV=development
SERVICE_NAME=worker
LOG_LEVEL=log
DATABASE_URL="postgresql://edu_api:edu_api@localhost:5433/edu_api?schema=public"
REDIS_URL="redis://localhost:6380"
# Admin invitation delivery. Generate both key values as shown in the admin API example.
ADMIN_APPLICATION_ORIGIN="http://localhost:3000"
ADMIN_SESSION_HMAC_KEY="replace-with-32-byte-base64url-key"
ADMIN_SECRET_ENCRYPTION_KEY_ID="local-v1"
ADMIN_SECRET_ENCRYPTION_KEY="replace-with-32-byte-base64url-key"
# Set real values only through deployment secret management; never commit them.
RESEND_API_KEY="replace-with-resend-api-key"
RESEND_FROM_EMAIL="EduVoucher <admin@example.com>"
ADMIN_INVITATION_EMAIL_MAX_ATTEMPTS=5
ADMIN_INVITATION_EMAIL_BATCH_SIZE=25
ADMIN_INVITATION_EMAIL_POLL_INTERVAL_MS=5000
