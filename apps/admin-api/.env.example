NODE_ENV=development
SERVICE_NAME=admin-api
HOST=0.0.0.0
PORT=3002
TRUST_PROXY_HOPS=0
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3003"
LOG_LEVEL=log
DATABASE_URL="postgresql://edu_api:edu_api@localhost:5433/edu_api?schema=public"
REDIS_URL="redis://localhost:6380"
# Generate each value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_APPLICATION_ORIGIN="http://localhost:3000"
ADMIN_SESSION_HMAC_KEY="replace-with-32-byte-base64url-key"
ADMIN_SECRET_ENCRYPTION_KEY_ID="local-v1"
ADMIN_SECRET_ENCRYPTION_KEY="replace-with-32-byte-base64url-key"
# Voucher PIN encryption uses separate keys. The Admin API needs these to
# import inventory; the worker will use them later only to deliver an existing allocation.
VOUCHER_SECRET_ENCRYPTION_KEY_ID="local-v1"
VOUCHER_SECRET_ENCRYPTION_KEY="replace-with-32-byte-base64url-key"
VOUCHER_PIN_FINGERPRINT_KEY="replace-with-a-different-32-byte-base64url-key"
VOUCHER_IMPORT_CHUNK_SIZE=1000
VOUCHER_IMPORT_MAX_BYTES=67108864
VOUCHER_IMPORT_STALE_AFTER_MS=900000
VOUCHER_IMPORT_RECOVERY_POLL_INTERVAL_MS=60000
# First Super Admin script only; set these in the current shell, never this file.
# ADMIN_INITIAL_SUPER_ADMIN_EMAIL="admin@example.com"
# ADMIN_INITIAL_SUPER_ADMIN_PASSWORD="use-a-unique-long-password"
