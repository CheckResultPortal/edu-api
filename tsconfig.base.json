{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "composite": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@edu-api/config": ["./libs/shared/config/src/index.ts"],
      "@edu-api/database": ["./libs/shared/database/src/index.ts"],
      "@edu-api/health": ["./libs/shared/health/src/index.ts"],
      "@edu-api/health/health.module": [
        "./libs/shared/health/src/lib/health.module.ts"
      ],
      "@edu-api/queues": ["./libs/shared/queues/src/index.ts"],
      "@edu-api/redis": ["./libs/shared/redis/src/index.ts"],
      "@edu-api/http": ["./libs/shared/http/src/index.ts"],
      "@edu-api/observability": ["./libs/shared/observability/src/index.ts"],
      "@edu-api/testing": ["./libs/shared/testing/src/index.ts"],
      "@edu-api/outbox": ["./libs/platform/outbox/src/index.ts"],
      "@edu-api/idempotency": ["./libs/platform/idempotency/src/index.ts"],
      "@edu-api/encryption": ["./libs/platform/encryption/src/index.ts"],
      "@edu-api/catalog": ["./libs/modules/catalog/src/index.ts"],
      "@edu-api/orders": ["./libs/modules/orders/src/index.ts"],
      "@edu-api/fulfilment": ["./libs/modules/fulfilment/src/index.ts"],
      "@edu-api/payments": ["./libs/modules/payments/src/index.ts"],
      "@edu-api/voucher-inventory": [
        "./libs/modules/voucher-inventory/src/index.ts"
      ],
      "@edu-api/communication": ["./libs/modules/communication/src/index.ts"],
      "@edu-api/stock-monitoring": [
        "./libs/modules/stock-monitoring/src/index.ts"
      ],
      "@edu-api/administration": ["./libs/modules/administration/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
